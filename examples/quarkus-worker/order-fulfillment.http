@application = http://localhost:8080
@taskId = copy-task-id-from-user-tasks

### Happy path: replace UUID before repeating
POST {{application}}/ingress/order-received
Content-Type: application/json

{
  "id": "d61a74aa-cb7e-48ed-a092-b539f9dc2eba",
  "shipmentAddress": {
    "streetLine": "Main 1",
    "zipCode": "12345",
    "city": "Berlin",
    "country": "DE"
  },
  "invoiceAddress": {
    "streetLine": "Main 1",
    "zipCode": "12345",
    "city": "Berlin",
    "country": "DE"
  },
  "orderPositions": [
    {
      "name": "book",
      "amount": 2,
      "price": 10.00
    }
  ]
}

